<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cavern.Format" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decoding helpers, optional for local builds (CI checks both are published):
         TrueHD built with "cargo build -r" in thd-objects, DTS with CMake in dtsx-objects (see its CMakeLists.txt) -->
    <None Include="thd-objects/target/release/thd-objects.exe" Condition="Exists('thd-objects/target/release/thd-objects.exe')"
          Link="thd-objects.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="dtsx-objects/build/Release/dtsx-objects.exe" Condition="Exists('dtsx-objects/build/Release/dtsx-objects.exe')"
          Link="dtsx-objects.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
