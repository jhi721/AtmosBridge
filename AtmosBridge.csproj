<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms> <!-- tray icon -->
    <ApplicationIcon>icons\atmosbridge.ico</ApplicationIcon> <!-- regenerate with icons\make_icons.py -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Loop methods (Feed, Pump, RenderLoop) JIT fully optimized at once: on-stack replacement with dynamic PGO
         stalled the helper feed ~150-190 ms once, ~20 s after start, longer than the latency cushion -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cavern.Format" Version="2.1.0" />
    <!-- WinForms only in Tray.cs: its global usings would make Timer ambiguous everywhere else -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decoding helpers, optional for local builds (CI checks both are published):
         TrueHD built with "cargo build -r" in thd-objects, DTS with CMake in dtsx-objects (see its CMakeLists.txt) -->
    <None Include="thd-objects/target/release/thd-objects.exe" Condition="Exists('thd-objects/target/release/thd-objects.exe')"
          Link="thd-objects.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="dtsx-objects/build/Release/dtsx-objects.exe" Condition="Exists('dtsx-objects/build/Release/dtsx-objects.exe')"
          Link="dtsx-objects.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="WarnMissingHelpers" BeforeTargets="Build">
    <Warning Condition="!Exists('thd-objects/target/release/thd-objects.exe')" Text="thd-objects.exe not built: TrueHD will not play" />
    <Warning Condition="!Exists('dtsx-objects/build/Release/dtsx-objects.exe')" Text="dtsx-objects.exe not built: DTS will not play" />
  </Target>

</Project>
